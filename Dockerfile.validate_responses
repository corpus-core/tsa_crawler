FROM node:22-alpine

# validate_responses uses Node builtins only (fs, path, crypto, url, global
# fetch). No npm install, no explainer. It imports the shared HTTP/pool helpers
# from gen_responses.mjs and the path helpers from query.mjs, so those two
# files ship alongside. Outbound HTTPS is only needed when the LLM judge is
# enabled (JUDGE_SAMPLE_PCT > 0).
WORKDIR /app
COPY src/validate_responses.mjs src/gen_responses.mjs src/query.mjs src/bucket_paths.mjs src/prom_file.mjs ./

# Non-root (uid 1000). The mounted volume must be owned by uid 1000
# (same as collector/prepare/dedup/gen-responses).
USER node

# Safe defaults; secrets (DEEPSEEK_API_KEY) come from compose environment.
ENV DATA_DIR=/data/traces/train \
    STYLES=simple \
    TRIVIAL_MAX=2 \
    RATIO_PASS=0.9 \
    RATIO_WARN=0.7 \
    SCALE_EXPONENTS=6,8,9,18 \
    JUDGE_SAMPLE_PCT=5 \
    JUDGE_SEED=1 \
    JUDGE_MODEL=deepseek-v4-pro \
    JUDGE_THINKING=enabled \
    JUDGE_REASONING_EFFORT=high \
    JUDGE_MAX_TOKENS=16384 \
    DEEPSEEK_BASE_URL=https://api.deepseek.com \
    CONCURRENCY=4 \
    MAX_RETRIES=5 \
    TIMEOUT_MS=600000 \
    PROGRESS_EVERY=100 \
    CHAIN=mainnet

CMD ["node", "validate_responses.mjs"]
