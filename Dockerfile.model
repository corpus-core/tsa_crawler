FROM nginx:1.27-alpine

# Serves converted MLC weights to WebLLM clients (see
# docker/model/default.conf.template). The weights are NOT part of the image:
# mount them read-only at /usr/share/nginx/html as
# <model_id>/<weights_version>/… (`tsa_train.py sync` produces that layout).
# Keeping them out of the image means the repo stays small and unreleased
# models never touch a registry.
#
# NGINX_PORT lets the server run with `network_mode: host` next to other
# services (the image's entrypoint renders /etc/nginx/templates/*.template
# into /etc/nginx/conf.d/ with envsubst).
ENV NGINX_PORT=80
COPY docker/model/default.conf.template /etc/nginx/templates/default.conf.template

HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- "http://127.0.0.1:${NGINX_PORT}/health" >/dev/null || exit 1
