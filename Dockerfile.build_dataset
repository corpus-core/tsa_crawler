FROM node:22-alpine

# build_dataset orchestrates dedup, gen_responses, validate_responses, and
# export_dataset in one process. Node builtins only; outbound HTTPS is needed
# for the DeepSeek calls inside gen and the judge sample.
WORKDIR /app
COPY src/build_dataset.mjs src/dedup.mjs src/gen_responses.mjs \
    src/validate_responses.mjs src/export_dataset.mjs \
    src/query.mjs src/bucket_paths.mjs src/prom_file.mjs ./

# Non-root (uid 1000). The mounted volume must be owned by uid 1000
# (same as collector/prepare/dedup). The devops override runs as root instead,
# because those named volumes are not writable by uid 1000.
USER node

ENV DATA_DIR=/data/traces \
    DEEPSEEK_BASE_URL=https://api.deepseek.com \
    MODEL=deepseek-v4-pro \
    STYLES=simple \
    THINKING=enabled \
    REASONING_EFFORT=high \
    MAX_TOKENS=16384 \
    CONCURRENCY=4 \
    MAX_RETRIES=5 \
    TIMEOUT_MS=600000 \
    KEEP_REASONING=1 \
    PROGRESS_EVERY=100 \
    CAP=5 \
    REQUIRE_RESOLVED=tx,events \
    STICKY=1 \
    REGEN_ROUNDS=1 \
    MIN_GROUNDING_RATIO=0.7 \
    REQUIRE_VALIDATION=1 \
    JUDGE_SAMPLE_PCT=5 \
    JUDGE_SEED=1 \
    JUDGE_MODEL=deepseek-v4-pro \
    JUDGE_THINKING=enabled \
    JUDGE_REASONING_EFFORT=high \
    JUDGE_MAX_TOKENS=16384 \
    CHAIN=mainnet

CMD ["node", "build_dataset.mjs"]
