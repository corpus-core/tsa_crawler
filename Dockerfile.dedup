FROM node:22-alpine

# Dedup uses Node builtins only (fs, path, crypto) plus query/bucket_paths.
# No npm install, no explainer.
WORKDIR /app
COPY src/dedup.mjs src/query.mjs src/bucket_paths.mjs src/prom_file.mjs ./

# Non-root (uid 1000). The mounted volume must be owned by uid 1000
# (same as collector/prepare).
USER node

ENV DATA_DIR=/data/traces \
    OUT=/data/traces/train \
    CAP=5 \
    CHAIN=mainnet \
    PROM_FILE=""

CMD ["node", "dedup.mjs"]
